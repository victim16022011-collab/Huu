		function TweenBoat(V)
			local M = Workspace.Boats[_G.SelectedBoat]
			if not M or not M:FindFirstChild("VehicleSeat") then
				return {
					Stop = function() end,
				}
			end
			local o = V
			if typeof(V) == "Instance" and V:IsA("BasePart") then
				o = V.CFrame
			elseif typeof(V) ~= "CFrame" then
				return {
					Stop = function() end,
				}
			end
			local l = M.VehicleSeat.Position
			local x = o.Position
			local g = (l - x).Magnitude
			local S = nil
			local f = g / (_G.BoatTweenSpeed or 100)
			local w = TweenInfo.new(f, Enum.EasingStyle.Linear)
			S = TweenService:Create(M.VehicleSeat, w, {
				CFrame = o,
			})
			if g > 25 then
				S:Play()
			else
				warn("Jarak terlalu dekat, tween dibatalkan.")
			end
			local O = {}
			function O.Stop(V)
				if S and S.PlaybackState == Enum.PlaybackState.Playing then
					S:Cancel()
				end
			end
			return O
		end
		function TweenPlayer(V)
			local M = (f.Position - V.Position).Magnitude
			local o = M / _G.PlayerTweenSpeed
			local l = TweenInfo.new(o, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
			local x = TweenService:Create(f, l, {
				CFrame = V,
			})
			x:Play()
			local g = {}
			function g.Stop(V)
				x:Cancel()
			end
			return g
		end
