	local foldMap = {}
	for replacement, characters in pairs({
		a = "àáảãạăằắẳẵặâầấẩẫậÀÁẢÃẠĂẰẮẲẴẶÂẦẤẨẪẬ",
		e = "èéẻẽẹêềếểễệÈÉẺẼẸÊỀẾỂỄỆ",
		i = "ìíỉĩịÌÍỈĨỊ",
		o = "òóỏõọôồốổỗộơờớởỡợÒÓỎÕỌÔỒỐỔỖỘƠỜỚỞỠỢ",
		u = "ùúủũụưừứửữựÙÚỦŨỤƯỪỨỬỮỰ",
		y = "ỳýỷỹỵỲÝỶỸỴ",
		d = "đĐ",
	}) do
		for _, code in utf8.codes(characters) do
			foldMap[code] = replacement
		end
	end
	local function normalized(text)
		local parts = {}
		for _, code in utf8.codes(tostring(text or "")) do
			parts[#parts + 1] = foldMap[code] or utf8.char(code)
		end
		return string.lower(table.concat(parts))
	end
	local function valueText(value)
		if type(value) == "table" then
			local result = {}
			for _, item in ipairs(value) do
				result[#result + 1] = tostring(item)
			end
			return table.concat(result, ", ")
		end
		if value == nil then
			return "Chưa chọn"
		end
		if type(value) == "boolean" then
			return value and "Bật" or "Tắt"
		end
		return tostring(value)
	end
	function AuroraUI:ShowHome()
		if not self.Home then
			return
		end
		self.ActiveTab = nil
		self.Home.Visible = true
		self.ContentTitle.Text = "Tổng quan"
		self.ContentHint.Text = "Dragon Hub · chọn mục để xem chức năng và điều kiện."
		self.EmptyLabel.Visible = false
		for _, tab in ipairs(self.TabList) do
			tab.Page.Visible = false
			tab.Button.BackgroundColor3 = palette.row
			tab.Button.Visible = true
		end
		self.HomeButton.BackgroundColor3 = palette.selected
		self:RefreshDashboard()
		if self.Compact then
			self:SetSidebar(false)
		end
	end
	function AuroraUI:RefreshDashboard()
		if not self.Cards then
			return
		end
		local report = Runtime:GetDiagnostics()
		self.Cards[1].Text = tostring(report.Bound) .. " / " .. tostring(report.Controls)
		self.Cards[2].Text = tostring(report.Active)
		self.Cards[3].Text = Runtime.Ready and "Sẵn sàng"
			or (Runtime.Booting and "Đang kết nối" or "Xem nhật ký")
		local player = Runtime.Player
		local data = player:FindFirstChild("Data")
		local level = data and data:FindFirstChild("Level")
		local character = player.Character
		local humanoid = character and character:FindFirstChild("Humanoid")
		local sea = report.World and "Sea " .. tostring(report.World) or "Ngoài Blox Fruits"
		self.ServerBadge.Text = "v" .. Runtime.Version .. "  /  " .. sea
		local lines = {
			"Người chơi: " .. player.Name,
			"Khu vực: " .. sea .. "   ·   Level: " .. (level and tostring(level.Value) or "—"),
			"Nhân vật: " .. (humanoid and tostring(math.floor(humanoid.Health)) .. " / " .. tostring(
				math.floor(humanoid.MaxHealth)
			) .. " HP" or "Đang chờ spawn"),
			"Nhật ký: "
				.. tostring(report.ErrorCount)
				.. " thông báo   ·   "
				.. tostring(#self.TabList)
				.. " nhóm chức năng",
		}
		self.SessionText.Text = table.concat(lines, "\n")
		local capabilities = {}
		for _, name in ipairs({
			"loadstring",
			"clipboard",
			"click",
			"touch",
			"prompt",
			"signals",
			"aimhook",
			"writefile",
			"readfile",
			"nilinstances",
		}) do
			capabilities[#capabilities + 1] = (report.Capabilities[name] and "✓ " or "· ") .. name
		end
		self.CapabilityText.Text = table.concat(capabilities, "   ")
			.. "\nMục thiếu API sẽ cần môi trường hỗ trợ chức năng tương ứng."
	end
	function AuroraUI:SetFilter(mode)
		self.FilterMode = mode
		for name, button in pairs(self.FilterButtons) do
			button.BackgroundColor3 = name == mode and palette.selected or palette.row
			button.TextColor3 = name == mode and palette.accent or palette.muted
		end
		self:Filter(self.Search.Text)
	end
	function AuroraUI:SetAccent(name)
		local definitions = {
			Ember = { 255, 111, 76, 76, 38, 32 },
			Gold = { 239, 188, 95, 73, 59, 33 },
			Jade = {
				79,
				212,
				171,
				26,
				65,
				58,
			},
		}
		name = definitions[name] and name or "Ember"
		local color = definitions[name]
		local previousAccent, previousSelected = palette.accent, palette.selected
		palette.accent = Color3.fromRGB(color[1], color[2], color[3])
		palette.selected = Color3.fromRGB(color[4], color[5], color[6])
		Runtime.Preferences.Accent = name
		for _, object in ipairs(Runtime.Gui:GetDescendants()) do
			if object:IsA("TextLabel") or object:IsA("TextButton") then
				if object.TextColor3 == previousAccent then
					object.TextColor3 = palette.accent
				end
			end
			if object:IsA("GuiObject") or object:IsA("Frame") or object:IsA("TextButton") then
				if object.BackgroundColor3 == previousAccent then
					object.BackgroundColor3 = palette.accent
				elseif object.BackgroundColor3 == previousSelected then
					object.BackgroundColor3 = palette.selected
				end
			end
		end
		for _, control in pairs(self.Controls) do
			control:Paint()
		end
		self:SetFilter(self.FilterMode)
	end
	function AuroraUI:ShowDetails(control)
