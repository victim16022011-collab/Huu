-- Aurora Custom: native UI and integrated recovered gameplay.
-- Lifecycle, diagnostics and shared services for Aurora Custom.
local nativeTask = task
local nativePcall = pcall
local unpackValues = table.unpack or unpack
local host = (getgenv and getgenv()) or _G
if host.AuroraCustomSession then
	nativePcall(function()
		host.AuroraCustomSession:Destroy()
	end)
end

local Runtime = {
	Alive = true,
	Ready = false,
	Flags = {},
	Threads = {},
	Connections = {},
	Controls = {},
	Errors = {},
	Warnings = {},
	Tweens = {},
	Collisions = {},
	Generation = 0,
	Booting = false,
	MaxErrors = 80,
	PressedKeys = {},
}
host.AuroraCustomSession = Runtime
Runtime.Players = game:GetService("Players")
Runtime.Player = Runtime.Players.LocalPlayer
Runtime.Input = game:GetService("UserInputService")
Runtime.Http = game:GetService("HttpService")
Runtime.Teleport = game:GetService("TeleportService")
Runtime.RunService = game:GetService("RunService")
Runtime.Workspace = game:GetService("Workspace")
assert(Runtime.Player, "Aurora Custom cần chạy ở Roblox client.")

function Runtime:SetStatus(message, failed)
	self.Status = tostring(message)
	self.Failed = failed == true
	if self.StatusLabel then
		self.StatusLabel.Text = self.Status
		self.StatusLabel.TextColor3 = failed and Color3.fromRGB(255, 137, 137) or Color3.fromRGB(156, 180, 200)
	end
end

function Runtime:Report(label, message)
	local text = tostring(message)
	local key = tostring(label) .. ": " .. text
	local now = os.clock()
	local previous = self.Warnings[key]
	self.Warnings[key] = { time = now, count = (previous and previous.count or 0) + 1 }
	if previous and now - previous.time < 15 then
		return
	end
	self.Errors[#self.Errors + 1] = { label = tostring(label), message = text, time = now }
	if #self.Errors > self.MaxErrors then
		table.remove(self.Errors, 1)
	end
	warn("[Aurora Custom] " .. key)
	if self.Alive then
		self:SetStatus("Có lỗi ở " .. tostring(label) .. " · bấm Nhật ký", true)
	end
end

function Runtime:Protected(label, callback, ...)
	local result = table.pack(nativePcall(callback, ...))
	if not result[1] then
		self:Report(label, result[2])
	end
	return unpackValues(result, 1, result.n)
end

function Runtime:Connect(signal, callback, kind)
	if not self.Alive then
		return { Disconnect = function() end }
	end
	local generation = self.Generation
	kind = kind or "backend"
	local connection = signal:Connect(function(...)
		if not self.Alive or (kind == "backend" and generation ~= self.Generation) then
			return
		end
		self:Protected(kind == "ui" and "giao diện" or "sự kiện", callback, ...)
	end)
	self.Connections[connection] = kind
	return connection
end

function Runtime:Spawn(callback, label, ...)
	if not self.Alive then
		return nil
	end
	local args = table.pack(...)
	local generation = self.Generation
	return nativeTask.spawn(function()
		local thread = coroutine.running()
		self.Threads[thread] = generation
		if self.Alive and generation == self.Generation then
			self:Protected(label or "tác vụ nền", callback, unpackValues(args, 1, args.n))
		end
		self.Threads[thread] = nil
	end)
end

function Runtime:Wait(seconds)
	if not self.Alive then
		return nil
	end
	local generation = self.Threads[coroutine.running()]
	if generation and generation ~= self.Generation then
		return nil
	end
	local elapsed = nativeTask.wait(seconds or 0.05)
	if not self.Alive or (generation and generation ~= self.Generation) then
		return nil
	end
	return elapsed
end

function Runtime:Delay(seconds, callback, ...)
	local args = table.pack(...)
	return self:Spawn(function()
		if self:Wait(seconds) then
			callback(unpackValues(args, 1, args.n))
		end
	end, "hẹn giờ")
end

function Runtime:WaitForChild(parent, name, timeout)
	assert(parent, "Không tìm thấy đối tượng cha của " .. tostring(name))
	local child = parent:FindFirstChild(name) or parent:WaitForChild(name, timeout or 12)
	assert(child, "Game chưa cung cấp " .. tostring(name) .. "; hãy thử Khởi động lại.")
	return child
end

function Runtime:GetInventory(remote)
	local complete, inventory = false, {}
	self:Spawn(function()
		local ok, result = self:Protected("đọc túi đồ", function()
			return remote:InvokeServer("getInventory")
		end)
		if ok and type(result) == "table" then
			inventory = result
		end
		complete = true
	end, "túi đồ")
	local deadline = os.clock() + 6
	repeat
		if complete then
			return inventory
		end
		self:Wait(0.05)
	until not self.Alive or os.clock() >= deadline
	self:Report("túi đồ", "Máy chủ chưa trả lời; bấm Khởi động lại để tải lại dữ liệu.")
	return inventory
end

function Runtime:CaptureCharacter(character)
	self.Character = character
	self.Collisions = {}
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			self.Collisions[part] = part.CanCollide
		end
	end
end

function Runtime:CancelMovement()
	for tween in pairs(self.Tweens) do
		nativePcall(function()
			tween:Cancel()
		end)
	end
	self.Tweens = {}
	if self.Character then
		local root = self.Character:FindFirstChild("HumanoidRootPart")
		local clip = root and root:FindFirstChild("BodyClip")
		if clip then
			clip:Destroy()
		end
		for part, collided in pairs(self.Collisions) do
			if part.Parent then
				nativePcall(function()
					part.CanCollide = collided
				end)
			end
		end
	end
end

function Runtime:TrackTween(tween)
	self:CancelTweens()
	self.Tweens[tween] = true
	return tween
end

function Runtime:CancelTweens()
	for tween in pairs(self.Tweens) do
		nativePcall(function()
			tween:Cancel()
		end)
	end
	self.Tweens = {}
end

function Runtime:SendKeyEvent(service, pressed, key, repeatKey, target)
	if pressed then
		self.PressedKeys[key] = service
	else
		self.PressedKeys[key] = nil
	end
	return service:SendKeyEvent(pressed, key, repeatKey, target)
end

function Runtime:NearestFruit(root)
	if not root then
		return nil
	end
	local selected, selectedHandle, distance
	for _, item in ipairs(self.Workspace:GetChildren()) do
		if string.find(string.lower(item.Name), "fruit", 1, true) then
			local handle = item:FindFirstChild("Handle")
			if not handle and item:IsA("Model") then
				handle = item.PrimaryPart
			end
			if handle and handle:IsA("BasePart") then
				local current = (handle.Position - root.Position).Magnitude
				if not distance or current < distance then
					selected, selectedHandle, distance = item, handle, current
				end
			end
		end
	end
	return selected, selectedHandle
end

function Runtime:ClearEsp(flag)
	local name = string.lower(tostring(flag))
	for _, object in ipairs(self.Workspace:GetDescendants()) do
		if object:IsA("BillboardGui") and string.lower(object.Name) == name then
			object:Destroy()
		end
	end
end

function Runtime:StopAll()
	self.Stopping = true
	for _, control in pairs(self.Controls) do
		if control.Kind == "Toggle" and control.Value then
			control:Set(false)
		end
	end
	for name, value in pairs(self.Flags) do
		if type(value) == "boolean" then
			self.Flags[name] = false
		end
	end
	self.Stopping = false
	if self.ResetBackendState then
		nativePcall(self.ResetBackendState)
	end
	for key, service in pairs(self.PressedKeys) do
		nativePcall(function()
			service:SendKeyEvent(false, key, false, game)
		end)
	end
	self.PressedKeys = {}
	self:CancelMovement()
	if self.Character and self.Workspace.CurrentCamera then
		local humanoid = self.Character:FindFirstChild("Humanoid")
		if humanoid then
			self.Workspace.CurrentCamera.CameraSubject = humanoid
		end
	end
	nativePcall(function()
		self.RunService:Set3dRenderingEnabled(true)
	end)
	if self.Ready then
		self:SetStatus("Đã dừng các chế độ tự động")
	end
end

function Runtime:Activate(control)
	if control.Group ~= "movement" or self.Stopping then
		return
	end
	for _, other in pairs(self.Controls) do
		if other ~= control and other.Group == "movement" and other.Value == true then
			other:Set(false)
		end
	end
end

function Runtime:StopWorkers()
	self.Generation = self.Generation + 1
	self.Ready = false
	if self.AimRestore then
		nativePcall(self.AimRestore)
		self.AimRestore = nil
	end
	self.RejoinConnection = nil
	self:CancelMovement()
	local current = coroutine.running()
	for connection, kind in pairs(self.Connections) do
		if kind == "backend" then
			nativePcall(function()
				connection:Disconnect()
			end)
			self.Connections[connection] = nil
		end
	end
	for thread in pairs(self.Threads) do
		if thread ~= current then
			nativePcall(function()
				nativeTask.cancel(thread)
			end)
		end
		self.Threads[thread] = nil
	end
end

function Runtime:StartBackend()
	if self.Booting then
		return
	end
	self:StopAll()
	self:StopWorkers()
	self.Booting = true
	for _, control in pairs(self.Controls) do
		control.Bound = control.Kind == "Paragraph"
		control.Value = nil
	end
	self.Flags = {}
	self:SetStatus("Đang kết nối dữ liệu nhân vật…")
	self:Spawn(function()
		local ok = self:Protected("khởi động", function()
			self.Bootstrap(self)
		end)
		self.Booting = false
		self.Ready = ok
		if ok then
			self:SetStatus("Sẵn sàng · " .. tostring(self.ControlCount or 0) .. " mục")
		else
			self:StopWorkers()
			self:SetStatus("Chưa khởi động xong · xem Nhật ký rồi bấm Khởi động lại", true)
		end
		for _, control in pairs(self.Controls) do
			if control.Paint then
				control:Paint()
			end
		end
	end, "khởi động")
end

function Runtime:ServerHop(placeId)
	placeId = tonumber(placeId) or game.PlaceId
	self:SetStatus("Đang tìm server còn chỗ…")
	local cursor = nil
	for _ = 1, 8 do
		local url = "https://games.roblox.com/v1/games/"
			.. tostring(placeId)
			.. "/servers/Public?sortOrder=Asc&limit=100"
		if cursor then
			url = url .. "&cursor=" .. self.Http:UrlEncode(cursor)
		end
		local response = self.Http:JSONDecode(game:HttpGet(url))
		assert(type(response) == "table" and type(response.data) == "table", "Danh sách server không hợp lệ")
		for _, server in ipairs(response.data) do
			if
				server.id ~= game.JobId
				and tonumber(server.playing)
				and tonumber(server.maxPlayers)
				and server.playing < server.maxPlayers
			then
				self.Teleport:TeleportToPlaceInstance(placeId, server.id, self.Player)
				return server.id
			end
		end
		cursor = response.nextPageCursor
		if not cursor or cursor == "" then
			break
		end
		if not self:Wait(0.2) then
			return nil
		end
	end
	error("Chưa tìm được server khác còn chỗ; thử lại sau.")
end

function Runtime:SaveConfig()
	assert(type(writefile) == "function", "Môi trường này không hỗ trợ lưu cấu hình")
	local values = {}
	for id, control in pairs(self.Controls) do
		if control.Kind ~= "Button" and control.Kind ~= "Paragraph" then
			values[id] = { kind = control.Kind, value = control.Value }
		end
	end
	if type(makefolder) == "function" then
		nativePcall(makefolder, "AuroraCustom")
	end
	writefile("AuroraCustom/config.json", self.Http:JSONEncode({ version = 1, values = values }))
	self:SetStatus("Đã lưu cấu hình")
end

function Runtime:LoadConfig()
	assert(type(readfile) == "function", "Môi trường này không hỗ trợ đọc cấu hình")
	local data = self.Http:JSONDecode(readfile("AuroraCustom/config.json"))
	assert(
		type(data) == "table" and data.version == 1 and type(data.values) == "table",
		"Cấu hình không hợp lệ"
	)
	self:StopAll()
	for id, item in pairs(data.values) do
		local control = self.Controls[id]
		if control and item.kind == control.Kind and control.Kind ~= "Toggle" then
			control:Set(item.value)
		end
	end
	self:SetStatus("Đã nạp tuỳ chọn · bật chế độ cần dùng trong menu")
end

function Runtime:Destroy()
	if not self.Alive then
		return
	end
	self:StopAll()
	self.Alive = false
	self:StopWorkers()
	for connection in pairs(self.Connections) do
		nativePcall(function()
			connection:Disconnect()
		end)
	end
	self.Connections = {}
	if self.Gui then
		self.Gui:Destroy()
	end
	if host.AuroraCustomSession == self then
		host.AuroraCustomSession = nil
	end
end

