	function AuroraUI:Tab(options)
		local id = options.AuroraId or options.Title
		if self.Tabs[id] then
			return self.Tabs[id]
		end
		local tab = { Id = id, Title = options.Title, Sections = {} }
		tab.Button = button(self.TabContainer, tab.Title)
		tab.Button.Size = UDim2.new(1, -5, 0, 34)
		tab.Button.TextSize = 12
		tab.Page = create("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 4,
			Visible = false,
		}, self.Pages)
		padding(tab.Page, 2)
		vertical(tab.Page, 10)
		function tab:Section(opts)
			return AuroraUI:Section(self, opts)
		end
		Runtime:Connect(tab.Button.Activated, function()
			self.Search.Text = ""
			self:SelectTab(tab.Id)
		end, "ui")
		self.Tabs[id] = tab
		self.TabList[#self.TabList + 1] = tab
		if #self.TabList == 1 then
			self:SelectTab(id)
		end
		return tab
	end

	function AuroraUI:SelectTab(id)
		local target = type(id) == "number" and self.TabList[id] or self.Tabs[id]
		if not target then
			return
		end
		self.ActiveTab = target
		for _, tab in ipairs(self.TabList) do
			tab.Page.Visible = tab == target
			tab.Button.BackgroundColor3 = tab == target and palette.selected or palette.row
		end
		self:Filter(self.Search and self.Search.Text or "")
	end

	function AuroraUI:Section(tab, options)
		local id = options.AuroraId or tab.Id .. ":" .. options.Title
		if self.Sections[id] then
			return self.Sections[id]
		end
		local section = { Id = id, Tab = tab, Title = options.Title, Controls = {} }
		section.Frame = create("Frame", {
			BackgroundColor3 = palette.panel,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -6, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		}, tab.Page)
		round(section.Frame, 9)
		padding(section.Frame, 9)
		vertical(section.Frame, 6)
		local heading = label(section.Frame, section.Title, 14, palette.accent)
		heading.LayoutOrder = -1
		for _, kind in ipairs({ "Toggle", "Button", "Dropdown", "Slider", "Input", "Paragraph" }) do
			section[kind] = function(current, opts)
				return AuroraUI:Control(current, kind, opts)
			end
		end
		self.Sections[id] = section
		tab.Sections[#tab.Sections + 1] = section
		return section
	end

	function AuroraUI:Filter(query)
		query = string.lower(tostring(query or ""))
		for _, tab in ipairs(self.TabList) do
			local tabMatch = false
			for _, section in ipairs(tab.Sections) do
				local sectionMatch = false
				for _, control in ipairs(section.Controls) do
					local text = string.lower(
						tab.Title .. " " .. section.Title .. " " .. control.Title .. " " .. tostring(control.Desc or "")
					)
					local matched = query == "" or string.find(text, query, 1, true) ~= nil
					control.Frame.Visible = matched
					sectionMatch = sectionMatch or matched
				end
				section.Frame.Visible = sectionMatch
				tabMatch = tabMatch or sectionMatch
			end
			tab.Button.Visible = query == "" or tabMatch
			tab.Page.Visible = tab == self.ActiveTab
		end
		if query ~= "" and self.ActiveTab and not self.ActiveTab.Button.Visible then
			for _, tab in ipairs(self.TabList) do
				if tab.Button.Visible then
					self.ActiveTab = tab
					for _, other in ipairs(self.TabList) do
						other.Page.Visible = other == tab
					end
					break
				end
			end
		end
		for _, tab in ipairs(self.TabList) do
			tab.Button.BackgroundColor3 = tab == self.ActiveTab and palette.selected or palette.row
		end
	end

	function AuroraUI:Control(section, kind, options)
		local id = options.AuroraId or section.Id .. ":" .. kind .. ":" .. options.Title
		local existing = self.Controls[id]
		if existing then
			existing:Bind(options)
			return existing
		end
		local control = {
			Id = id,
			Kind = kind,
			Section = section,
			Title = options.Title or kind,
			Value = nil,
			Values = {},
			Bound = false,
		}
		control.Frame = create("Frame", {
			BackgroundColor3 = palette.row,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		}, section.Frame)
		round(control.Frame, 7)
		padding(control.Frame, 9)
		vertical(control.Frame, 5)
		control.Heading = label(control.Frame, control.Title, 13)
		control.Heading.Size = UDim2.new(1, -4, 0, 28)
		control.Description = label(control.Frame, "", 11, palette.muted)
		control.Description.AutomaticSize = Enum.AutomaticSize.Y
		control.Description.Size = UDim2.new(1, 0, 0, 0)
		if kind == "Toggle" or kind == "Button" or kind == "Dropdown" then
			control.Action = button(control.Frame, kind == "Button" and "Chạy" or "…")
			control.Action.Size = UDim2.new(1, 0, 0, 30)
		elseif kind == "Slider" or kind == "Input" then
			control.Field = create("TextBox", {
				BackgroundColor3 = palette.background,
				BorderSizePixel = 0,
				TextColor3 = palette.text,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				ClearTextOnFocus = false,
				Text = "",
				Size = UDim2.new(1, 0, 0, 30),
			}, control.Frame)
			round(control.Field, 6)
			if kind == "Slider" then
				control.Track = button(control.Frame, "")
				control.Track.Size = UDim2.new(1, 0, 0, 15)
				control.Fill = create(
					"Frame",
					{ BackgroundColor3 = palette.accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) },
					control.Track
				)
				round(control.Fill, 6)
			end
		end
		if kind == "Dropdown" then
			control.List = create("ScrollingFrame", {
				BackgroundColor3 = palette.background,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 130),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				CanvasSize = UDim2.new(),
				ScrollBarThickness = 3,
				Visible = false,
			}, control.Frame)
			round(control.List, 6)
			padding(control.List, 5)
			vertical(control.List, 3)
			control.OptionButtons = {}
			control.OptionConnections = {}
		end
		function control:Paint()
			self.Heading.Text = self.Title
			self.Description.Text = tostring(self.Desc or "")
			self.Description.Visible = self.Desc ~= nil and self.Desc ~= ""
			if self.Kind == "Toggle" then
				self.Action.Text = self.Value and "BẬT" or "TẮT"
				self.Action.BackgroundColor3 = self.Value and palette.selected or palette.background
			elseif self.Kind == "Dropdown" then
				local text = self.Multi and type(self.Value) == "table" and table.concat(self.Value, ", ")
					or tostring(self.Value or "Chọn…")
				self.Action.Text = text .. "  ▾"
			elseif self.Field then
				self.Field.Text = tostring(self.Value or "")
			end
			if self.Fill then
				local range = math.max(1, self.Max - self.Min)
				self.Fill.Size =
					UDim2.fromScale(math.clamp(((tonumber(self.Value) or self.Min) - self.Min) / range, 0, 1), 1)
			end
			if self.Action then
				self.Action.TextColor3 = Runtime.Ready and self.Bound and palette.text or palette.muted
			end
		end
		function control:Set(value, silent)
			local previous = self.Value
			if self.Kind == "Toggle" then
				value = value == true
				if value and self.World and self.World ~= Runtime.World then
					AuroraUI:Notify({ Content = "Chức năng này cần Sea " .. tostring(self.World) })
					value = false
				end
				if value then
					Runtime:Activate(self)
				end
			elseif self.Kind == "Slider" then
				value = tonumber(value)
				if not value then
					self:Paint()
					return
				end
				value = math.clamp(
					self.Min + math.floor((value - self.Min) / self.Step + 0.5) * self.Step,
					self.Min,
					self.Max
				)
			elseif self.Kind == "Input" then
				value = tostring(value or "")
			elseif self.Kind == "Dropdown" then
				if self.Multi then
					local selected = {}
					local wanted = type(value) == "table" and value or { value }
					for _, candidate in ipairs(self.Values) do
						for _, item in ipairs(wanted) do
							if candidate == item then
								selected[#selected + 1] = candidate
								break
							end
						end
					end
					value = selected
				elseif value ~= nil then
					local found = false
					for _, candidate in ipairs(self.Values) do
						if candidate == value then
							found = true
							break
						end
					end
					if not found then
						self:Paint()
						return
					end
				end
			end
			self.Value = copy(value)
			self:Paint()
			if not silent and self.Callback and (Runtime.Ready or Runtime.Booting) then
				Runtime:Protected(self.Title, self.Callback, copy(self.Value))
			end
			if self.Kind == "Toggle" and previous == true and self.Value == false then
				for _, key in ipairs(self.Flags or {}) do
					if key:sub(1, 3) == "Esp" then
						Runtime:ClearEsp(key)
					end
					if key == "NoClip" then
						Runtime:CancelMovement()
					end
				end
			end
		end
		function control:Select(value)
			self:Set(value)
		end
		function control:SetDesc(text)
			self.Desc = tostring(text or "")
			self:Paint()
		end
		function control:Refresh(values)
			self.Values = {}
			for _, item in ipairs(type(values) == "table" and values or {}) do
				self.Values[#self.Values + 1] = item
			end
			if not self.List then
				return
			end
			for _, connection in ipairs(self.OptionConnections) do
				connection:Disconnect()
				Runtime.Connections[connection] = nil
			end
			self.OptionConnections = {}
			for _, object in ipairs(self.OptionButtons) do
				object:Destroy()
			end
			self.OptionButtons = {}
			for _, item in ipairs(self.Values) do
				local choice = button(self.List, tostring(item))
				choice.Size = UDim2.new(1, -4, 0, 27)
				self.OptionButtons[#self.OptionButtons + 1] = choice
				local connection = Runtime:Connect(choice.Activated, function()
					if not Runtime.Ready or not self.Bound then
						return
					end
					if self.Multi then
						local selected = copy(self.Value or {})
						local found
						for index, value in ipairs(selected) do
							if value == item then
								found = index
								break
							end
						end
						if found then
							table.remove(selected, found)
						else
							selected[#selected + 1] = item
						end
						self:Set(selected)
					else
						self:Set(item)
						self.List.Visible = false
					end
				end, "ui")
				self.OptionConnections[#self.OptionConnections + 1] = connection
			end
		end
		function control:Bind(opts)
			self.Title = opts.Title or self.Title
			self.Desc = opts.Desc
			self.Group = opts.AuroraGroup or self.Group
			self.World = opts.AuroraWorld or self.World
			self.Flags = opts.AuroraFlags or self.Flags or {}
			if opts.Callback then
				self.Callback = opts.Callback
				self.Bound = true
			end
			if self.Kind == "Paragraph" then
				self.Bound = true
				self:Paint()
				return
			end
			if self.Kind == "Slider" then
				local range = type(opts.Value) == "table" and opts.Value or {}
				self.Min = tonumber(range.Min) or self.Min or 0
				self.Max = tonumber(range.Max) or self.Max or 100
				self.Step = math.max(0.001, tonumber(opts.Step) or 1)
				self:Set(range.Value or self.Value or self.Min)
			elseif self.Kind == "Dropdown" then
				self.Multi = opts.Multi == true
				self:Refresh(opts.Values)
				self:Set(opts.Value, opts.Value == nil)
			elseif self.Kind == "Toggle" then
				local initial = opts.Value
				if initial == nil then
					initial = opts.Default
				end
				self:Set(initial == true)
			elseif self.Kind == "Input" then
				self:Set(opts.Value or "", true)
			else
				self:Paint()
			end
		end
		local function interact(callback)
			if not Runtime.Ready or not control.Bound then
				AuroraUI:Notify({ Content = "Đang kết nối chức năng; xem trạng thái ở cuối cửa sổ." })
				return
			end
			Runtime:Spawn(callback, control.Title)
		end
		if control.Action then
			Runtime:Connect(control.Action.Activated, function()
				interact(function()
					if kind == "Toggle" then
						control:Set(not control.Value)
					elseif kind == "Dropdown" then
						control.List.Visible = not control.List.Visible
					elseif control.Callback then
						Runtime:Protected(control.Title, control.Callback)
					end
				end)
			end, "ui")
		end
		if control.Field then
			Runtime:Connect(control.Field.FocusLost, function()
				interact(function()
					control:Set(control.Field.Text)
				end)
			end, "ui")
		end
		if control.Track then
			local dragging = false
			local function slide(input)
				if not Runtime.Ready or not control.Bound then
					return
				end
				local width = math.max(1, control.Track.AbsoluteSize.X)
				local alpha = math.clamp((input.Position.X - control.Track.AbsolutePosition.X) / width, 0, 1)
				control:Set(control.Min + alpha * (control.Max - control.Min))
			end
			Runtime:Connect(control.Track.InputBegan, function(input)
				if
					input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					dragging = true
					slide(input)
				end
			end, "ui")
			Runtime:Connect(Runtime.Input.InputChanged, function(input)
				if
					dragging
					and (
						input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch
					)
				then
					slide(input)
				end
			end, "ui")
			Runtime:Connect(Runtime.Input.InputEnded, function(input)
				if
					input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					dragging = false
				end
			end, "ui")
		end
		self.Controls[id] = control
		section.Controls[#section.Controls + 1] = control
		Runtime.ControlCount = (Runtime.ControlCount or 0) + 1
		control:Bind(options)
		return control
	end

	function AuroraUI:AddTheme(options)
		self.Themes[options.Name] = options
	end
	function AuroraUI:SetTheme(name)
		self.ActiveTheme = name
	end
	function AuroraUI:Gradient(colors, options)
		return { Colors = colors, Options = options }
	end

	function AuroraUI:Preload(manifest)
		self:CreateWindow({ Title = "Aurora Custom" })
		local objects = { window = self.Window }
		for _, item in ipairs(manifest) do
			local parent = objects[item.Parent]
			assert(parent, "Thiếu nhóm giao diện " .. tostring(item.Parent))
			local opts = copy(item.Options)
			opts.AuroraId = item.Id
			opts.AuroraGroup = item.Group
			opts.AuroraWorld = item.World
			opts.AuroraFlags = item.Flags
			objects[item.Id] = parent[item.Kind](parent, opts)
		end
		self:SelectTab(1)
	end

	return AuroraUI
end)()

