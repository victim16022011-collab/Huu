function Runtime:NilInstances()
	if type(getnilinstances) == "function" then
		return getnilinstances()
	end
	return {}
end
function Runtime:RegisterBossQuest(boss, data)
	assert(type(boss) == "string" and boss ~= "", "Tên boss không hợp lệ")
	assert(type(data) == "table" and type(data.NameQuest) == "string" and data.NameQuest ~= "", "Thiếu NameQuest")
	assert(
		type(data.LevelQuest) == "number" and data.LevelQuest >= 1 and data.LevelQuest % 1 == 0,
		"LevelQuest phải là số nguyên dương"
	)
	assert(typeof(data.QuestCFrame) == "CFrame", "QuestCFrame phải là CFrame")
	self.BossQuests[boss] = { NameQuest = data.NameQuest, LevelQuest = data.LevelQuest, QuestCFrame = data.QuestCFrame }
end
function Runtime:SetSoulGuitarData(data)
