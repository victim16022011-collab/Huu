	function RefreshMasterySwords()
		local generation = Runtime.Generation
		if Runtime.SwordInventoryGeneration == generation then
			return
		end
		Runtime.SwordInventoryGeneration = generation
		Runtime:Spawn(function()
			local ok, inventory = pcall(function()
				return Runtime:GetInventory(Remotes.CommF_)
			end)
			if Runtime.SwordInventoryGeneration == generation then
				Runtime.SwordInventoryGeneration = nil
			end
			if not Runtime.Alive or generation ~= Runtime.Generation or not ok or type(inventory) ~= "table" then
				return
			end
			local names, seen = {}, {}
			for _, item in ipairs(inventory) do
				if item.Type == "Sword" and type(item.Name) == "string" and not seen[item.Name] then
					names[#names + 1] = item.Name
					seen[item.Name] = true
				end
			end
			table.sort(names)
			local selected = ChooseSwordDropdown.Value
			SwordList = names
			ChooseSwordDropdown:Refresh(names)
			if selected and seen[selected] then
				ChooseSwordDropdown:Set(selected, true)
			elseif selected then
				ChooseSwordDropdown:Set(nil, true)
				_G.SelectedMasterySword = nil
			end
		end, "đọc danh sách kiếm")
	end
