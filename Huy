	function AuroraUI:Filter(query)
		query = normalized(query)
		local mode = self.FilterMode or "All"
		local firstMatch
		for _, tab in ipairs(self.TabList) do
			local tabMatch = false
			local count = 0
			for _, section in ipairs(tab.Sections) do
				local sectionMatch = false
				for _, control in ipairs(section.Controls) do
					local meta = control.Metadata or {}
					local text = normalized(
						tab.Title
							.. " "
							.. (tab.Metadata.DisplayTitle or "")
							.. " "
							.. section.Title
							.. " "
							.. control.Title
							.. " "
							.. tostring(control.Desc or "")
							.. " "
							.. (meta.SearchASCII or "")
					)
					local matched = query == "" or string.find(text, query, 1, true) ~= nil
					if mode == "Active" then
						matched = matched and control.Kind == "Toggle" and control.Value == true
					elseif mode == "Favorites" then
						matched = matched and Runtime.Favorites[control.Id] == true
					elseif mode == "Sea" then
						local allowed = not control.World or control.World == Runtime.World
						local worlds = (control.Metadata or {}).Worlds
						if worlds and #worlds > 0 then
							allowed = false
							for _, world in ipairs(worlds) do
								if world == Runtime.World then
									allowed = true
								end
							end
						end
						matched = matched and allowed
					end
					control.Frame.Visible = matched and (not section.Collapsed or query ~= "" or mode ~= "All")
					if control.Favorite then
						control.Favorite.Text = Runtime.Favorites[control.Id] and "★" or "☆"
					end
					sectionMatch = sectionMatch or matched
					if matched then
						count = count + 1
					end
				end
				section.Frame.Visible = sectionMatch
				tabMatch = tabMatch or sectionMatch
			end
			tab.VisibleCount = count
			tab.Button.Visible = (query == "" and mode == "All") or tabMatch
			if tabMatch and not firstMatch then
				firstMatch = tab
			end
			tab.Page.Visible = tab == self.ActiveTab
		end
		if (query ~= "" or mode ~= "All") and (not self.ActiveTab or not self.ActiveTab.Button.Visible) then
			self.ActiveTab = firstMatch
		end
		if self.ActiveTab then
			self.Home.Visible = false
			self.HomeButton.BackgroundColor3 = palette.row
			self.ContentTitle.Text = self.ActiveTab.Metadata.DisplayTitle or self.ActiveTab.Title
			self.ContentHint.Text = tostring(self.ActiveTab.VisibleCount or 0)
				.. " mục · "
				.. (self.ActiveTab.Metadata.Help or "Bấm Chi tiết để xem cách dùng.")
		elseif query ~= "" or mode ~= "All" then
			self.Home.Visible = false
		end
		local searching = query ~= "" or mode ~= "All"
		self.EmptyLabel.Visible = searching and not firstMatch
		for _, tab in ipairs(self.TabList) do
			tab.Page.Visible = tab == self.ActiveTab
			tab.Button.BackgroundColor3 = tab == self.ActiveTab and palette.selected or palette.row
		end
	end

