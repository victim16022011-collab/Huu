		for _, object in ipairs(workspace:GetChildren()) do
			if object.Name == "Flower1" or object.Name == "Flower2" then
				add(object)
			end
		end
	elseif flag == "EspMonster" or flag == "EspSeabeast" then
		for _, model in ipairs(folder(flag == "EspMonster" and "Enemies" or "SeaBeasts")) do
			local humanoid = model:FindFirstChild("Humanoid")
			if humanoid and humanoid.Health > 0 then
				add(model, nil, nil, humanoid)
			end
		end
	elseif flag == "EspNpc" or flag == "EspAdvFruitDealer" or flag == "EspAura" then
		local selected = flag == "EspAdvFruitDealer" and "Advanced Fruit Dealer"
			or (flag == "EspAura" and "Master of Enhancement" or nil)
		for _, npc in ipairs(folder("NPCs")) do
			if not selected or npc.Name == selected then
				add(npc)
			end
		end
	elseif flag == "EspGear" then
		local map = workspace:FindFirstChild("Map")
		local island = map and map:FindFirstChild("MysticIsland")
		if island then
			for _, part in ipairs(island:GetChildren()) do
				if part.Name == "MeshPart" or string.find(string.lower(part.Name), "gear", 1, true) then
					add(part, "Gear / " .. part.Name, Color3.fromRGB(100, 230, 240))
				end
			end
		end
	else
		local names = {
			EspMirage = "Mirage Island",
			EspKitsune = "Kitsune Island",
			EspFrozen = "Frozen Dimension",
			EspPrehistoric = "Prehistoric Island",
		}
		for _, object in ipairs(locations and locations:GetChildren() or {}) do
			if flag == "EspIsland" or names[flag] == object.Name then
				add(object)
			end
		end
	end
	for root, record in pairs(registry) do
		if not targets[root] or not root.Parent or not record.Gui.Parent then
			record.Gui:Destroy()
			registry[root] = nil
		end
	end
	for root, target in pairs(targets) do
		local record = registry[root]
		if not record then
			local gui = Instance.new("BillboardGui")
			gui.Name = flag
			gui.Adornee = root
			gui.AlwaysOnTop = true
			gui.Size = UDim2.fromOffset(205, 56)
			gui.StudsOffset = Vector3.new(0, 3, 0)
			gui.Parent = root
			local label = Instance.new("TextLabel")
			label.Name = "TextLabel"
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamMedium
			label.TextSize = 12
			label.TextWrapped = true
			label.TextStrokeTransparency = 0.45
			label.Size = UDim2.fromScale(1, 1)
			label.Parent = gui
			record = { Gui = gui, Label = label }
			registry[root] = record
		end
		local distance = math.floor((playerRoot.Position - root.Position).Magnitude / 3 + 0.5)
		local extra = target.Health and (" · HP " .. tostring(math.floor(target.Health.Health))) or ""
		record.Label.Text = target.Title .. "\n" .. tostring(distance) .. " M" .. extra
		record.Label.TextColor3 = target.Color
	end
end

function Runtime:Path(root, ...)
	local current = root
	for _, name in ipairs({ ... }) do
		if not current then
			return nil
		end
		current = current:FindFirstChild(name)
	end
	return current
end

-- Startup isolation and explicit states for executors with partial API support.
Runtime.Version = "2.1.0"
Runtime.BootTimeout = 30
Runtime.DependencyTimeout = 15
Runtime.PendingValues = {}
Runtime.Dependencies = {}
Runtime.BootState = "idle"
Runtime.BootIssues = {}
function Runtime:IsSetting(control)
	return control.Kind == "Dropdown" or control.Kind == "Slider" or control.Kind == "Input"
end
function Runtime:CanInteract(control)
	if not self.Alive then
		return false, "Phiên đã đóng; chạy lại script."
	end
	if self:IsSetting(control) then
		return true
	end
	if not self.Ready then
		if self.BootState == "failed" then
			return false,
				"Khởi động thất bại: "
					.. tostring(self.BootError or self.Status)
					.. " · bấm Khởi động lại hoặc Nhật ký."
		end
		return false,
			tostring(self.BootDetail or "Đang chuẩn bị dữ liệu game")
				.. " · có thể chọn cấu hình trước."
	end
	if not control.Bound then
		return false, "Mục '" .. control.Title .. "' chưa nối được hàm xử lý; xem Nhật ký khởi tạo."
	end
	return true
end
function Runtime:ApplySetting(control, value)
	if not control.Bound or self.Booting or (not self.Ready and not self.CoreReady) then
		control:Set(value, true)
		self.PendingValues[control.Id] = control.Value
		return
	end
	control:Set(value)
end
function Runtime:BootStep(label, callback, ...)
	self.BootDetail = tostring(label)
	local result = table.pack(nativePcall(callback, ...))
	if not result[1] then
		if label == "hook kỹ năng" and self.AimRestore then
			nativePcall(self.AimRestore)
			self.AimRestore = nil
		end
		self.BootIssues[#self.BootIssues + 1] = { label = label, message = tostring(result[2]) }
		self:Report("khởi tạo: " .. label, result[2])
		return nil
	end
	return unpackValues(result, 2, result.n)
end
function Runtime:AwaitCore()
	self.World = ({ [2753915549] = 1, [4442272183] = 2, [7449423635] = 3 })[game.PlaceId]
	assert(self.World, "Hãy vào Blox Fruits Sea 1, 2 hoặc 3 trước khi bật chức năng.")
	local storage = game:GetService("ReplicatedStorage")
	local deadline = os.clock() + self.DependencyTimeout
	repeat
		local player = self.Player
		local character = player.Character
		local data = player:FindFirstChild("Data")
		local remotes = storage:FindFirstChild("Remotes")
		local checks = {
			{ character, "Character" },
			{ character and character:FindFirstChild("Humanoid"), "Character.Humanoid" },
			{ character and character:FindFirstChild("HumanoidRootPart"), "Character.HumanoidRootPart" },
			{ data and data:FindFirstChild("Level"), "Data.Level" },
			{ remotes and remotes:FindFirstChild("CommF_"), "ReplicatedStorage.Remotes.CommF_" },
			{ self.Workspace:FindFirstChild("Enemies"), "Workspace.Enemies" },
		}
		local missing = {}
		for _, entry in ipairs(checks) do
			if not entry[1] then
				missing[#missing + 1] = entry[2]
			end
		end
		if #missing == 0 then
			self.CoreReady = true
			return
		end
		self.BootState = "waiting"
		self.BootDetail = "Đang chờ: " .. table.concat(missing, ", ")
		self:SetStatus(self.BootDetail)
		if not self:Wait(0.2) then
			error("Phiên khởi động đã dừng")
		end
	until os.clock() >= deadline
	error(
		self.BootDetail .. " (hết thời gian chờ); đợi nhân vật tải xong rồi bấm Khởi động lại."
	)
end
function Runtime:PrepareBackendEnvironment()
	self.BackendEnv = self.BackendBase or host
	if type(getfenv) ~= "function" or type(setfenv) ~= "function" then
		return
	end
	local ok, reason = nativePcall(function()
		self.BackendBase = self.BackendBase or getfenv(self.Bootstrap)
		local environment = setmetatable({}, { __index = self.BackendBase })
		environment._G = environment
		setfenv(self.Bootstrap, environment)
		self.BackendEnv = environment
	end)
	if not ok then
		self.EnvironmentNote = "Delta/executor từ chối setfenv; dùng môi trường hiện tại: "
			.. tostring(reason)
	end
end
function Runtime:StartRaidCatalog(storage)
	local catalog = { raids = {}, advancedRaids = {} }
	local generation = self.Generation
	self.Dependencies.RaidCatalog = { state = "loading", message = "Đang tải danh sách chip Raid" }
	local complete = false
	local worker = self:Spawn(function()
		local deadline = os.clock() + 8
		local module = storage:FindFirstChild("Raids")
		while not module and os.clock() < deadline do
			if not self:Wait(0.2) then
				return
			end
			module = storage:FindFirstChild("Raids")
		end
		if not module then
			error("Game chưa cung cấp ReplicatedStorage.Raids")
		end
		local data = require(module)
		assert(type(data) == "table" and type(data.raids) == "table", "Module Raids không trả danh sách hợp lệ")
		if generation ~= self.Generation then
			return
		end
		catalog.raids = data.raids
		catalog.advancedRaids = type(data.advancedRaids) == "table" and data.advancedRaids or {}
		local values = {}
		for _, list in ipairs({ catalog.raids, catalog.advancedRaids }) do
			for _, value in pairs(list) do
				if type(value) == "string" then
					values[#values + 1] = value
				end
			end
		end
		local control = self.Controls.aurora_146
		if control then
			control:Refresh(values)
			if self.PendingValues[control.Id] then
				control:Set(self.PendingValues[control.Id])
			end
		end
		complete = true
		self.Dependencies.RaidCatalog = { state = "ready" }
	end, "danh sách chip Raid")
	self:Delay(10, function()
		if complete or generation ~= self.Generation then
			return
		end
		if worker then
			nativePcall(nativeTask.cancel, worker)
			self.Threads[worker] = nil
		end
		local message = "Không tải được module Raids trong 10 giây; các nhóm khác vẫn hoạt động."
		self.Dependencies.RaidCatalog = { state = "failed", message = message }
		self:Report("danh sách chip Raid", message)
	end)
	return catalog
end
function Runtime:StartBackend()
	self:StopAll()
	self:StopWorkers()
	self.Booting = true
	self.BootState = "starting"
	self.BootError = nil
	self.BootIssues = {}
	self.CoreReady = false
	self.Flags = {}
	self:PrepareBackendEnvironment()
	for _, control in pairs(self.Controls) do
		if not control.Extension then
			control.Bound = control.Kind == "Paragraph"
			control.Value = nil
		end
	end
	self:SetStatus("Đang kiểm tra dữ liệu game · vẫn có thể chọn vũ khí/cấu hình")
	local generation = self.Generation
	-- Use the native scheduler for the deadline so a blocked backend cannot block it.
	self:Spawn(function()
		if not self:Wait(self.BootTimeout) or generation ~= self.Generation or not self.Booting then
			return
		end
		local detail = self.BootDetail or "backend"
		self:StopWorkers()
		self.Booting = false
		self.BootState = "failed"
		self.BootError = "Quá 30 giây tại: " .. detail
		self:Report("khởi động", self.BootError)
		self:SetStatus(self.BootError .. " · bấm Khởi động lại", true)
	end, "giới hạn khởi động")
	self:Spawn(function()
		local ok, reason = self:Protected("khởi động", function()
			self:AwaitCore()
			self.BootState = "binding"
			self.Bootstrap(self)
		end)
		if generation ~= self.Generation then
			return
		end
		self.Booting = false
		if not ok then
			self:StopWorkers()
			self.BootState = "failed"
			self.BootError = tostring(reason)
			self:SetStatus("Khởi động thất bại: " .. self.BootError, true)
		else
			self.Ready = true
			self.BootState = #self.BootIssues > 0 and "partial" or "ready"
			for id, value in pairs(self.PendingValues) do
				local control = self.Controls[id]
				if control and control.Bound and self:IsSetting(control) then
					control:Set(value)
				end
			end
			self:SetStatus(
				"Đã nối chức năng · "
					.. tostring(self.ControlCount)
					.. " mục"
					.. (#self.BootIssues > 0 and " · xem mục thiếu trong Nhật ký" or "")
			)
		end
		for _, control in pairs(self.Controls) do
			control:Paint()
		end
	end, "khởi động")
end

function Runtime:OnControlDisabled(control)
	local environment = self.BackendEnv
	if not environment then
		return
	end
	for _, flag in ipairs(control.Flags or {}) do
		if flag == "AutoFarmFruitMastery" then
			environment.UseSkill = false
			environment.Skillaimbot = false
		end
		if flag == "AutoFarmGunMastery" then
			environment.UseGunSkill = false
			environment.Skillaimbot = false
		end
		if flag == "AutoTrain" then
			environment.StartFarmTrain = false
		end
	end
end

