				for V, M in pairs(M.Anims:GetChildren()) do
					if M:IsA("Animation") then
						if
							M.AnimationId == "rbxassetid://8708221792"
							or M.AnimationId == "rbxassetid://8708222556"
							or M.AnimationId == "rbxassetid://8708223619"
