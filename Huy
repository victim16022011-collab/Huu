					for V, o in ipairs(l) do
						table.insert(M, o)
					end
				end
			elseif V == "Rare - Common" then
				if o == "Rare" or o == "Uncommon" or o == "Common" then
					for V, o in ipairs(l) do
						table.insert(M, o)
					end
				end
			elseif V == "Uncommon - Common" then
				if o == "Uncommon" or o == "Common" then
					for V, o in ipairs(l) do
						table.insert(M, o)
					end
				end
			elseif V == "Common" then
				if o == "Common" then
					for V, o in ipairs(l) do
