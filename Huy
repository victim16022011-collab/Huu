	function AuroraUI:Tab(options)
		local id = options.AuroraId or options.Title
		if self.Tabs[id] then
			return self.Tabs[id]
		end
		local tab = { Id = id, Title = options.Title, Sections = {}, Metadata = options.DragonMeta or {} }
		tab.Button = button(self.TabContainer, tab.Metadata.DisplayTitle or tab.Title)
		tab.Button.LayoutOrder = #self.TabList + 1
