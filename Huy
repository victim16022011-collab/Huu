function Runtime:ValidateControl(control, value)
	if not value or control.Kind ~= "Toggle" then
		return true
	end
	if control.World and control.World ~= self.World then
		return false, "Chức năng này cần Sea " .. tostring(control.World)
	end
	local titles = {
		SelectedMon = "quái ở Choose Mon",
		SelectedBoss = "boss ở Choose Boss",
		SelectedMaterial = "nguyên liệu ở Choose Material",
		SelectedMasterySword = "kiếm sở hữu ở Choose Sword",
		SelectedPlayer = "người chơi ở Choose Player",
		SelectIsland = "đảo",
		SelectNPC = "NPC",
		SelectedChip = "chip Raid",
		SelectedBoat = "thuyền",
		SelectedZone = "vùng biển",
	}
	for _, key in ipairs((control.Metadata or {}).Requirements or {}) do
		local setting = self.Flags[key]
		if setting == nil or setting == "" or (type(setting) == "table" and next(setting) == nil) then
			return false, "Chưa chọn " .. (titles[key] or key) .. "; chọn trước rồi bật lại."
		end
	end
	local worlds = (control.Metadata or {}).Worlds
	if worlds and #worlds > 0 then
		local found = false
		local labels = {}
		for _, world in ipairs(worlds) do
			if world == self.World then
				found = true
			end
			labels[#labels + 1] = tostring(world)
		end
		if not found then
			return false, "Chức năng này cần Sea " .. table.concat(labels, " / ")
		end
	end
	for _, flag in ipairs(control.Flags or {}) do
		if
			(flag == "AutoFarmSwordMastery" or flag == "AutoFarmFruitMastery" or flag == "AutoFarmGunMastery")
			and self.Flags.MasteryMethod == "Boss"
		then
			if not self.BossQuests[self.Flags.SelectedBoss or ""] then
				return false,
					"Mastery Boss thiếu bảng quest cho boss đã chọn. Chọn Quest/Nearest hoặc tích hợp RegisterBossQuest."
			end
		end
	end
	return true
end
function Runtime:GetFeature(id)
	return self.Controls[id]
end
function Runtime:SetFeature(id, value)
	assert(self.Ready, "Dragon Hub chưa kết nối xong chức năng")
	local control = assert(self.Controls[id], "Không có chức năng " .. tostring(id))
	assert(control.Bound, "Chức năng chưa được gắn hàm xử lý")
	if control.Kind == "Button" then
		return self:Protected(control.Title, control.Callback)
	end
	control:Set(value)
	return control.Value
end
function Runtime:AddFeature(options)
	assert(type(options) == "table" and type(options.Id) == "string", "Cần Id riêng cho chức năng tích hợp")
	assert(not self.Controls[options.Id], "Id đã tồn tại: " .. options.Id)
	local kinds = { Toggle = true, Button = true, Dropdown = true, Slider = true, Input = true, Paragraph = true }
	assert(kinds[options.Kind], "Loại điều khiển không hỗ trợ")
	local tabName = options.Tab or "Tích hợp"
	local tab = self.UI:Tab({ Title = tabName, AuroraId = "extension_tab_" .. tabName })
	local section = self.UI:Section(tab, {
		Title = options.Section or "Chức năng riêng",
		AuroraId = "extension_section_" .. tabName .. ":" .. (options.Section or "Chức năng riêng"),
	})
	local config = {}
	for key, value in pairs(options) do
		config[key] = value
	end
	config.AuroraId = options.Id
	config.AuroraFlags = options.Flags or {}
	config.AuroraGroup = options.Group
	config.AuroraWorld = options.World
	local control = self.UI:Control(section, options.Kind, config)
	control.Extension = true
	self.UI:Filter(self.UI.Search.Text)
	return control
end
function Runtime:GetDiagnostics()
	local report = {
		Version = self.Version,
		BootState = self.BootState,
		BootError = self.BootError,
		BootDetail = self.BootDetail,
		EnvironmentNote = self.EnvironmentNote,
		Ready = self.Ready,
		World = self.World,
		Status = self.Status,
		Controls = 0,
		Bound = 0,
		Active = 0,
		ErrorCount = #self.Errors,
		MissingBossQuests = next(self.BossQuests) == nil,
		MissingSoulGuitarData = self.PuzzleData.SoulGuitar == nil,
		Capabilities = {},
	}
	for _, control in pairs(self.Controls) do
		report.Controls = report.Controls + 1
		if control.Bound then
			report.Bound = report.Bound + 1
		end
		if control.Kind == "Toggle" and control.Value then
			report.Active = report.Active + 1
		end
	end
	local capabilities = {
		loadstring = loadstring,
		clipboard = setclipboard,
		click = fireclickdetector,
		touch = firetouchinterest,
		prompt = fireproximityprompt,
		signals = firesignal,
		readfile = readfile,
		writefile = writefile,
		hiddenproperty = sethiddenproperty,
		nilinstances = getnilinstances,
	}
	for _, name in ipairs({
		"loadstring",
		"clipboard",
		"click",
		"touch",
		"prompt",
		"signals",
		"readfile",
		"writefile",
		"hiddenproperty",
		"nilinstances",
	}) do
		report.Capabilities[name] = type(capabilities[name]) == "function"
	end
	report.Capabilities.aimhook = type(getrawmetatable) == "function"
		and type(setreadonly) == "function"
		and type(newcclosure) == "function"
		and type(getnamecallmethod) == "function"
	return report
end

-- Shared ESP renderer: every Adornee is a BasePart, never a Model.
function Runtime:EspRoot(object)
	if not object then
		return nil
	end
	if object:IsA("BasePart") then
		return object
	end
	local root = object:FindFirstChild("HumanoidRootPart")
		or object:FindFirstChild("Handle")
		or object:FindFirstChild("Head")
	if root and root:IsA("BasePart") then
		return root
	end
	if object:IsA("Model") and object.PrimaryPart then
		return object.PrimaryPart
	end
	for _, part in ipairs(object:GetDescendants()) do
		if part:IsA("BasePart") then
			return part
		end
	end
end
function Runtime:RefreshEsp(flag)
	if not self.Flags[flag] then
		return
	end
	local workspace = self.Workspace
	local character = self.Player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not playerRoot then
		return
	end
	self.EspObjects = self.EspObjects or {}
	local registry = self.EspObjects[flag] or {}
	self.EspObjects[flag] = registry
	local targets = {}
	local function add(object, title, color, health)
		local root = self:EspRoot(object)
		if root then
			targets[root] =
				{ Title = title or object.Name, Color = color or Color3.fromRGB(255, 190, 110), Health = health }
		end
	end
	local function folder(name)
		local value = workspace:FindFirstChild(name)
		return value and value:GetChildren() or {}
	end
	local origin = workspace:FindFirstChild("_WorldOrigin")
	local locations = origin and origin:FindFirstChild("Locations")
	if flag == "EspPlayer" then
		for _, player in ipairs(self.Players:GetPlayers()) do
			local model = player.Character
			local humanoid = model and model:FindFirstChild("Humanoid")
			if player ~= self.Player and humanoid and humanoid.Health > 0 then
				add(
					model,
					player.Name,
					player.Team == self.Player.Team and Color3.fromRGB(100, 225, 160) or Color3.fromRGB(255, 120, 120),
					humanoid
				)
			end
		end
	elseif flag == "EspChest" then
		local candidates = folder("ChestModels")
		if #candidates == 0 then
			candidates = workspace:GetChildren()
		end
		for _, object in ipairs(candidates) do
			if string.find(string.lower(object.Name), "chest", 1, true) then
				add(object)
			end
		end
	elseif flag == "EspDevilfruit" then
		for _, object in ipairs(workspace:GetDescendants()) do
			if
				(object:IsA("Tool") or object:IsA("Model")) and string.find(string.lower(object.Name), "fruit", 1, true)
			then
