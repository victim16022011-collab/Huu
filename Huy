		if control.Kind == "Dropdown" then
			lines[#lines + 1] = "Chọn: " .. (control.Multi and "nhiều giá trị" or "một giá trị")
			lines[#lines + 1] = "Danh sách hiện tại: " .. table.concat(control.Values, ", ")
		end
		if #(meta.Requirements or {}) > 0 then
			lines[#lines + 1] = "Tuỳ chọn liên quan: " .. table.concat(meta.Requirements, ", ")
